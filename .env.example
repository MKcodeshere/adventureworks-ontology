DATABASE_URL=host=127.0.0.1 port=5433 dbname=Adventureworks user=postgres password=postgres

# LLM provider: ollama | gemini | openai | anthropic
LLM_PROVIDER=ollama

# --- Ollama (local or cloud) ---
# Local daemon (default):
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# Ollama Cloud (https://ollama.com):
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=  # Bearer token; never commit
# OLLAMA_MODEL=gpt-oss:120b
# (CLI cloud tags like gpt-oss:120b-cloud map to API name gpt-oss:120b)

# --- Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Streamlit UI: streamlit run app/app.py
# Prefers Ollama Cloud when OLLAMA_API_KEY is set; else Gemini/OpenAI/Anthropic.
